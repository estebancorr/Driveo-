;align=left;verticalAlign=top;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#14283f;spacing=0;" vertex="1" parent="new10" connectable="0"><mxGeometry x="14" y="44.0" width="962" height="75.0" as="geometry" /></mxCell><object id="old11" label="" tooltip="MC — Mercadeo Corporativo"><mxCell style="rounded=1;arcSize=8;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=1.5;html=0;" vertex="1" parent="1"><mxGeometry x="40" y="1826.0" width="470" height="125.0" as="geometry" /></mxCell></object><mxCell id="old11-title" value="MC — Mercadeo Corporativo" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=19;fontStyle=1;fontColor=#14283f;spacing=0;" vertex="1" parent="old11" connectable="0"><mxGeometry x="14" y="12.0" width="442" height="24.0" as="geometry" /></mxCell><object id="new11" label="" tooltip="Posible correspondencia: CRM / Mercadeo"><mxCell style="rounded=1;arcSize=8;fillColor=#f3f4f6;strokeColor=#6b7280;strokeWidth=1.5;html=0;" vertex="1" parent="1"><mxGeometry x="650" y="1826.0" width="990" height="125.0" as="geometry" /></mxCell></object><mxCell id="new11-title" value="Posible correspondencia: CRM / Mercadeo" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=19;fontStyle=1;fontColor=#14283f;spacing=0;" vertex="1" parent="new11" connectable="0"><mxGeometry x="14" y="12.0" width="962" height="24.0" as="geometry" /></mxCell><mxCell id="new11-body" value="Página de Notion vacía; suscripciones no demuestra CRM corporativo completo." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#14283f;spacing=0;" vertex="1" parent="new11" connectable="0"><mxGeometry x="14" y="44.0" width="962" height="75.0" as="geometry" /></mxCell><object id="old12" label="" tooltip="PP — Productos y Precios (registro en Notion)"><mxCell style="rounded=1;arcSize=8;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=1.5;html=0;" vertex="1" parent="1"><mxGeometry x="40" y="1977.0" width="470" height="125.0" as="geometry" /></mxCell></object><mxCell id="old12-title" value="PP — Productos y Precios (registro en Notion)" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=19;fontStyle=1;fontColor=#14283f;spacing=0;" vertex="1" parent="old12" connectable="0"><mxGeometry x="14" y="12.0" width="442" height="24.0" as="geometry" /></mxCell><object id="new12" label="" tooltip="Catálogo y Asignación de Precios, como candidatos"><mxCell style="rounded=1;arcSize=8;fillColor=#f3f4f6;strokeColor=#6b7280;strokeWidth=1.5;html=0;" vertex="1" parent="1"><mxGeometry x="650" y="1977.0" width="990" height="125.0" as="geometry" /></mxCell></object><mxCell id="new12-title" value="Catálogo y Asignación de Precios, como candidatos" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=19;fontStyle=1;fontColor=#14283f;spacing=0;" vertex="1" parent="new12" connectable="0"><mxGeometry x="14" y="12.0" width="962" height="24.0" as="geometry" /></mxCell><mxCell id="new12-body" value="El rótulo PP no aparece en el texto de las cinco diapositivas; Precios se sitúa en CI en la primera. Confirmar versión del diseño." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#14283f;spacing=0;" vertex="1" parent="new12" connectable="0"><mxGeometry x="14" y="44.0" width="962" height="75.0" as="geometry" /></mxCell><object id="old13" label="" tooltip="BI Corp (Notion)"><mxCell style="rounded=1;arcSize=8;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=1.5;html=0;" vertex="1" parent="1"><mxGeometry x="40" y="2128.0" width="470" height="125.0" as="geometry" /></mxCell></object><mxCell id="old13-title" value="BI Corp (Notion)" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=19;fontStyle=1;fontColor=#14283f;spacing=0;" vertex="1" parent="old13" connectable="0"><mxGeometry x="14" y="12.0" width="442" height="24.0" as="geometry" /></mxCell><object id="new13" label="" tooltip="Sin área Business Intelligence separada en el menú observado"><mxCell style="rounded=1;arcSize=8;fillColor=#f3f4f6;strokeColor=#6b7280;strokeWidth=1.5;html=0;" vertex="1" parent="1"><mxGeometry x="650" y="2128.0" width="990" height="125.0" as="geometry" /></mxCell></object><mxCell id="new13-title" value="Sin área Business Intelligence separada en el menú observado" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=19;fontStyle=1;fontColor=#14283f;spacing=0;" vertex="1" parent="new13" connectable="0"><mxGeometry x="14" y="12.0" width="962" height="24.0" as="geometry" /></mxCell><mxCell id="new13-body" value="Notion indica En desarrollo. No confundir automáticamente con el área visible Inteligencia de Negocios." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#14283f;spacing=0;" vertex="1" parent="new13" connectable="0"><mxGeometry x="14" y="44.0" width="962" height="75.0" as="geometry" /></mxCell><mxCell id="edge-0" value="candidato / alcance por validar" style="edgeStyle=none;html=0;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#7c3aed;fontFamily=Arial;fontSize=14;fontColor=#7c3aed;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="old0" target="new0"><mxGeometry x="0.0" y="-14" relative="1" as="geometry"><mxPoint x="510" y="227.5" as="sourcePoint" /><mxPoint x="650" y="227.5" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge-1" value="candidato / alcance por validar" style="edgeStyle=none;html=0;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#7c3aed;fontFamily=Arial;fontSize=14;fontColor=#7c3aed;label