;align=left;verticalAlign=top;fontFamily=Arial;fontSize=19;fontStyle=1;fontColor=#14283f;spacing=0;" vertex="1" parent="new3" connectable="0"><mxGeometry x="14" y="12.0" width="962" height="24.0" as="geometry" /></mxCell><mxCell id="new3-body" value="B2B y Facturación ya constan dentro de Comercial en el diseño original; su promoción de nivel no demuestra función nueva." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#14283f;spacing=0;" vertex="1" parent="new3" connectable="0"><mxGeometry x="14" y="44.0" width="962" height="75.0" as="geometry" /></mxCell><object id="old4" label="" tooltip="CI — Control de Inventario"><mxCell style="rounded=1;arcSize=8;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=1.5;html=0;" vertex="1" parent="1"><mxGeometry x="40" y="769.0" width="470" height="125.0" as="geometry" /></mxCell></object><mxCell id="old4-title" value="CI — Control de Inventario" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=19;fontStyle=1;fontColor=#14283f;spacing=0;" vertex="1" parent="old4" connectable="0"><mxGeometry x="14" y="12.0" width="442" height="24.0" as="geometry" /></mxCell><object id="new4" label="" tooltip="Catálogo, WMS y Kardex; Precios en Comercial"><mxCell style="rounded=1;arcSize=8;fillColor=#f3f4f6;strokeColor=#6b7280;strokeWidth=1.5;html=0;" vertex="1" parent="1"><mxGeometry x="650" y="769.0" width="990" height="125.0" as="geometry" /></mxCell></object><mxCell id="new4-title" value="Catálogo, WMS y Kardex; Precios en Comercial" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=19;fontStyle=1;fontColor=#14283f;spacing=0;" vertex="1" parent="new4" connectable="0"><mxGeometry x="14" y="12.0" width="962" height="24.0" as="geometry" /></mxCell><mxCell id="new4-body" value="Distribución funcional inferida; límites y propietario de stock/costo pendientes." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#14283f;spacing=0;" vertex="1" parent="new4" connectable="0"><mxGeometry x="14" y="44.0" width="962" height="75.0" as="geometry" /></mxCell><object id="old5" label="" tooltip="AF — Administrativos y Financieros"><mxCell style="rounded=1;arcSize=8;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=1.5;html=0;" vertex="1" parent="1"><mxGeometry x="40" y="920.0" width="470" height="125.0" as="geometry" /></mxCell></object><mxCell id="old5-title" value="AF — Administrativos y Financieros" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=19;fontStyle=1;fontColor=#14283f;spacing=0;" vertex="1" parent="old5" connectable="0"><mxGeometry x="14" y="12.0" width="442" height="24.0" as="geometry" /></mxCell><object id="new5" label="" tooltip="Administración y Finanzas / CxC, CxP, Bancos y Cajas"><mxCell style="rounded=1;arcSize=8;fillColor=#f3f4f6;strokeColor=#6b7280;strokeWidth=1.5;html=0;" vertex="1" parent="1"><mxGeometry x="650" y="920.0" width="990" height="125.0" as="geometry" /></mxCell></object><mxCell id="new5-title" value="Administración y Finanzas / CxC, CxP, Bancos y Cajas" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=19;fontStyle=1;fontColor=#14283f;spacing=0;" vertex="1" parent="new5" connectable="0"><mxGeometry x="14" y="12.0" width="962" height="24.0" as="geometry" /></mxCell><mxCell id="new5-body" value="Compras Generales original sin equivalencia específica comprobada." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#14283f;spacing=0;" vertex="1" parent="new5" connectable="0"><mxGeometry x="14" y="44.0" width="962" height="75.0" as="geometry" /></mxCell><object id="old6" label="" tooltip="CF — Contables y Fiscales"><mxCell style="rounded=1;arcSize=8;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=1.5;html=0;" vertex="1" parent="1"><mxGeometry x="40" y="1071.0" width="470" height="125.0" as="geometry" /></mxCell></object><mxCell id="old6-title" value="CF — Contables y Fiscales" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=19;fontStyle=1;fontColor=#14283f;spacing=0;" vertex="1" parent="old6" connectable="0"><mxGeometry x="14" y="12.0" width="442" height="24.0" as="geometry" /></mxCell><object id="new6" label="" tooltip="Administración y Finanzas / Contabilidad; libros en Compras y Facturación"><mxCell style="rounded=1;arcSize=8;fillColor=#f3f4f6;strokeColor=#6b7280;strokeWidth=1.5;html=0;" vertex="1" parent="1"><mxGeometry x="650" y="1071.0" width="990" height="125.0" as="geometry" /></mxCell></object><mxCell id="new6-title" value="Administración y Finanzas / Contabilidad; libros en Compras y Facturación" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=19;fontStyle=1;fontColor=#14283f;spacing=0;" vertex="1" parent="new6" connectable="0"><mxGeometry x="14" y="12.0" width="962" height="24.0" as="geometry" /></mxCell><mxCell id="new6-body" value="Contabilidad visible; equivalencia fiscal integral pendiente. No existe rótulo separado Módulo Fiscal en el menú observado." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#14283f;spacing=0;" vertex="1" parent="new6" connectable="0"><mxGeometry x="14" y="44.0" width="962" height="75.0" as="geometry" /></mxCell><object id="old7" label="" tooltip="CH — Capital Humano"><mxCell style="rounded=1;arcSize=8;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=1.5;html=0;" vertex="1" parent="1"><mxGeometry x="40" y="1222.0" width="470" height="125.0" as="geometry" /></mxCell></object><mxCell id="old7-title" value="CH — Capital Humano" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=19;fontStyle=1;fontColor=#14283f;spacing=0;" vertex="1" parent="old7" connectable="0"><mxGeometry x="14" y="12.0" width="442" height="24.0" as="geometry" /></mxCell><object id="new7" label="" tooltip="Talento Humano / Estructura Organizativa"><mxCell style="rounded=1;arcSize=8;fillColor=#f3f4f6;strokeColor=#6b7280;strokeWidth=1.5;html=0;" vertex="1" parent="1"><mxGeometry x="650" y="1222.0" width="990" height="125.0" as="geometry" /></mxCell></object><mxCell id="new7-title" value="Talento Humano / Estructura Organizativa" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=19;fontStyle=1;fontColor=#14283f;spacing=0;" vertex="1" parent="new7" connectable="0"><mxGeometry x="14" y="12.0" width="962" height="24.0" as="geometry" /></mxCell><mxCell id="new7-body" value="Nómina, liquidaciones, vacaciones, horarios y llamados de atención originales no se localizaron en este menú; no declarar inexistencia global." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#14283f;spacing=0;" vertex="1" parent="new7" connectable="0"><mxGeometry x="14" y="44.0" width="962" height="75.0" as="geometry" /></mxCell><object id="old8" label="" tooltip="GA — Garantía"><mxCell style="rounded=1;arcSize=8;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=1.5;html=0;" vertex="1" parent="1"><mxGeometry x="40" y="1373.0" width="470" height="125.0" as="geometry" /></mxCell></object><mxCell id="old8-title" value="GA — Garantía" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=19;fontStyle=1;fontColor=#14283f;spacing=0;" vertex="1" parent="old8" connectable="0"><mxGeometry x="14" y="12.0" width="442" height="24.0" as="geometry" /></mxCell><object id="new8" label="" tooltip="Taller y Garantías / Garantías (importadora)"><mxCell style="rounded=1;arcSize=8;fillColor=#f3f4f6;strokeColor=#6b7280;strokeWidth=1.5;html=0;" vertex="1" parent="1"><mxGeometry x="650" y="1373.0" width="990" height="125.0" as="geometry" /></mxCell></object><mxCell id="new8-title" value="Taller y Garantías / Garantías (importadora)" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=19;fontStyle=1;fontColor=#14283f;spacing=0;" vertex="1" parent="new8" connectable="0"><mxGeometry x="14" y="12.0" width="962" height="24.0" as="geometry" /></mxCell><mxCell id="new8-body" value="Tablero remite a garantías; servicio integral de taller pendiente según Notion, no probado en producción." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#14283f;spacing=0;" vertex="1" parent="new8" connectable="0"><mxGeometry x="14" y="44.0" width="962" height="75.0" as="geometry" /></mxCell><object id="old9" label="" tooltip="PA — Planeación de Abastecimiento"><mxCell style="rounded=1;arcSize=8;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=1.5;html=0;" vertex="1" parent="1"><mxGeometry x="40" y="1524.0" width="470" height="125.0" as="geometry" /></mxCell></object><mxCell id="old9-title" value="PA — Planeación de Abastecimiento" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=19;fontStyle=1;fontColor=#14283f;spacing=0;" vertex="1" parent="old9" connectable="0"><mxGeometry x="14" y="12.0" width="442" height="24.0" as="geometry" /></mxCell><object id="new9" label="" tooltip="No localizado como módulo en esta cuenta"><mxCell style="rounded=1;arcSize=8;fillColor=#f3f4f6;strokeColor=#6b7280;strokeWidth=1.5;html=0;" vertex="1" parent="1"><mxGeometry x="650" y="1524.0" width="990" height="125.0" as="geometry" /></mxCell></object><mxCell id="new9-title" value="No localizado como módulo en esta cuenta" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;vertical