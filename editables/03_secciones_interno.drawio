ada, no la fórmula ni generación de OC."><mxCell edge="1" parent="1" source="CS.3.2.3" target="CS.3.2.2" style="edgeStyle=none;html=0;endArrow=block;endFill=1;strokeWidth=2.4;strokeColor=#21627d;fontFamily=Arial;fontSize=15;fontColor=#21627d;labelBackgroundColor=#f4f8fa;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1263" y="812.0" /><mxPoint x="1263" y="632.1999999999999" /><mxPoint x="1317" y="632.1999999999999" /></Array></mxGeometry></mxCell></object><object id="edge1" label="R02" tooltip="Recepciones referencia el número de orden de compra. | E06 | No se creó una recepción ni se comprobó obligatoriedad de OC."><mxCell edge="1" parent="1" source="CS.3.2.4" target="CS.3.2.2" style="edgeStyle=none;html=0;endArrow=block;endFill=1;strokeWidth=2.4;strokeColor=#21627d;fontFamily=Arial;fontSize=15;fontColor=#21627d;labelBackgroundColor=#f4f8fa;exitX=0.0;exitY=0.5;entryX=0.0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1317" y="812.0" /><mxPoint x="1317" y="632.1999999999999" /></Array></mxGeometry></mxCell></object><object id="edge2" label="R03-OC" tooltip="Facturas de Compra referencia la orden de compra. | E07 | No se validó conciliación automática de cantidades o importes."><mxCell edge="1" parent="1" source="CS.3.2.6" target="CS.3.2.2" style="edgeStyle=none;html=0;endArrow=block;endFill=1;strokeWidth=2.4;strokeColor=#21627d;fontFamily=Arial;fontSize=15;fontColor=#21627d;labelBackgroundColor=#f4f8fa;exitX=0.0;exitY=0.5;entryX=0.0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1317" y="991.8" /><mxPoint x="1317" y="632.1999999999999" /></Array></mxGeometry></mxCell></object><object id="edge3" label="R03-RE" tooltip="Facturas de Compra referencia la recepción. | E07 | No se validó conciliación automática de cantidades o importes."><