ces" link="https://datsoft.truster.cloud/supply-chain/purchases/purchase-invoices" linkTarget="_blank"><mxCell style="rounded=1;arcSize=8;fillColor=#ecfdf5;strokeColor=#0f766e;strokeWidth=1.5;html=0;fontSize=16;fontStyle=0;whiteSpace=wrap;overflow=hidden;spacingTop=10;spacingLeft=13;spacingRight=13;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="70" y="180.0" width="400" height="115.0" as="geometry" /></mxCell></object><object id="s1" label="CS.3.5.1 · Libro Kardex&#10;Consulta el historial de movimientos de existencias." tooltip="Consulta el historial de movimientos de existencias. | Interfaz de consulta observada; ejecución no probada | Cargo propuesto: Analista de inventario y costos | https://datsoft.truster.cloud/supply-chain/kardex/ledger" link="https://datsoft.truster.cloud/supply-chain/kardex/ledger" linkTarget="_blank"><mxCell style="rounded=1;arcSize=8;fillColor=#ecfdf5;strokeColor=#0f766e;strokeWidth=1.5;html=0;fontSize=16;fontStyle=0;whiteSpace=wrap;overflow=hidden;spacingTop=10;spacingLeft=13;spacingRight=13;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="70" y="337.0" width="400" height="115.0" as="geometry" /></mxCell></object><object id="s2" label="Ven.5.2.1 · Facturas&#10;Consulta facturas y sus referencias de pedido y entrega." tooltip="Consulta facturas y sus referencias de pedido y entrega. | Libro de ventas se observó deshabilitado en ese momento. No establecer disponibilidad permanente por este estado. | Cargo propuesto: Analista de facturación | https://datsoft.truster.cloud/sales/billing/invoices" link="https://datsoft.truster.cloud/sales/billing/invoices" linkTarget="_blank"><mxCell style="rounded=1;arcSize=8;fillColor=#ecfdf5;strokeColor=#0f766e;strokeWidth=1.5;html=0;fontSize=16;fontStyle=0;whiteSpace=wrap;overflow=hidden;spacingTop=10;spacingLeft=13;spacingRight=13;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="70" y="494.0" width="400" height="115.0" as="geometry" /></mxCell></