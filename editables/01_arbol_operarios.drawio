hiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#14283f;spacing=0;" vertex="1" parent="srg" connectable="0"><mxGeometry x="14" y="44.0" width="312" height="50.0" as="geometry" /></mxCell><object id="separate" label="" tooltip="Consultas independientes hasta validar sus vínculos"><mxCell style="rounded=1;arcSize=8;fillColor=#f3f4f6;strokeColor=#6b7280;strokeWidth=1.5;html=0;" vertex="1" parent="1"><mxGeometry x="70" y="920.0" width="1500" height="210.0" as="geometry" /></mxCell></object><mxCell id="separate-title" value="Consultas independientes hasta validar sus vínculos" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=19;fontStyle=1;fontColor=#14283f;spacing=0;" vertex="1" parent="separate" connectable="0"><mxGeometry x="14" y="12.0" width="1472" height="24.0" as="geometry" /></mxCell><mxCell id="separate-body" value="R17: Asignaciones muestra un acceso a Solicitudes, pero no se ejecutó su transformación.&#10;R21 y R22: venta → comisión y venta/entrega → póliza son hipótesis del mapa interno.&#10;Taller: el tablero observado remite a garantías; el servicio integral de taller no está demostrado.&#10;Auditoría de RGH apareció como enlace adicional en Revisión de garantías y no fue abierta." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#14283f;spacing=0;" vertex="1" parent="separate" connectable="0"><mxGeometry x="14" y="44.0" width="1472" height="160.0" as="geometry" /></mxCell><mxCell id="edge-0" value="R16 · solicitud para dictamen" style="edgeStyle=none;html=0;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#0f766e;fontFamily=Arial;fontSize=14;fontColor=#0f766e;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="srg" target="war"><mxGeometry x="0.0" y="-14" relative="1" as="g