referencias comprobadas"><mxGraphModel dx="1700" dy="1410" grid="1" gridSize="10" page="1" pageWidth="1700" pageHeight="1410.0" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="page-title" value="Comercial, entrega y cobranza · referencias comprobadas" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=32;fontStyle=1;fontColor=#14283f;spacing=0;" vertex="1" parent="1" connectable="0"><mxGeometry x="40" y="30.0" width="1620" height="50.0" as="geometry" /></mxCell><mxCell id="page-subtitle" value="La interfaz contempla entrega sin factura y factura sin entrega. Las condiciones de cada alternativa deben validarse" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=17;fontStyle=0;fontColor=#14283f;spacing=0;" vertex="1" parent="1" connectable="0"><mxGeometry x="40" y="92.0" width="1620" height="50.0" as="geometry" /></mxCell><mxCell id="page-footer" value="DRIVEO · Base: cuenta actual · 16/11/2026 · v0.1 | UI = consulta observada; no acredita ejecución ni permisos de otros roles" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=14;fontStyle=0;fontColor=#526277;spacing=0;" vertex="1" parent="1" connectable="0"><mxGeometry x="40" y="1365.0" width="1620" height="30.0" as="geometry" /></mxCell><object id="ped" label="Ven.5.1.7 · Pedidos&#10;Consulta pedidos, clientes y estado de atención." tooltip="Consulta pedidos, clientes y estado de atención. | Interfaz de consulta observada; ejecución no probada | Cargo propuesto: Coordinador comercial | https://datsoft.truster.cloud/sales/commercial/orders" link="https://datsoft.truster.cloud/sales/commercial/orders" linkTarget="_blank"><mxCell style="rounded=1;arcSize=8;fillColor=#ecfdf5;strokeColor=#0f766e;strokeWidth=1.5;html=0;fontSize=16;fontStyle=0;whiteSpace=wrap;overflow=hidden;spacingTop=10;spacingLeft=13;spacingRight=13;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="70" y="200.0" width="340" height="145.0" as="geometry" /></mxCell></object><object id="oe" label="CS.3.6.1 · Notas de Entrega&#10;Consulta entregas y su referencia al pedido comercial." tooltip="Consulta entregas y su referencia al pedido comercial. | El menú dice Notas de Entrega y la pantalla Órdenes de Entrega; se conserva la equivalencia de navegación, sin afirmar equivalencia legal. | Cargo propuesto: Coordinador de logística | https://datsoft.truster.cloud/supply-chain/logistics/wms/delivery-notes" link="https://datsoft.truster.cloud/supply-chain/logistics/wms/delivery-notes" linkTarget="_blank"><mxCell style="rounded=1;arcSize=8;fillColor=#ecfdf5;strokeColor=#0f766e;strokeWidth=1.5;html=0;fontSize=16;fontStyle=0;whiteSpace=wrap;overflow=hidden;spacingTop=10;spacingLeft=13;spacingRight=13;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="650" y="200.0" width="340" height="145.0" as="geometry" /></mxCell></object><object id="bill" label="Ven.5.2.1 · Facturas&#10;Consulta facturas y sus referencias de pedido y entrega." tooltip="Consulta facturas y sus referencias de pedido y entrega. | Libro de ventas se observó deshabilitado en ese momento. No establecer disponibilidad permanente por este estado. | Cargo propuesto: Analista de facturación | https://datsoft.truster.cloud/sales/billing/invoices" link="https://datsoft.truster.cloud/sales/billing/invoices" linkTarget="_blank"><mxCell style="rounded=1;arcSize=8;fillColor=#ecfdf5;strokeColor=#0f766e;strokeWidth=1.5;html=0;fontSize=16;fontStyle=0;whiteSpace=wrap;overflow=hidden;spacingTop=10;spacingLeft=13;spacingRight=13;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="1230" y="200.0" width="340" height="145.0" as="geometry" /></mxCell></object><object id="por" label="AF.6.1.2 · Por facturar&#10;Identifica entregas que todavía no tienen factura." tooltip="Identifica entregas que todavía no tienen factura. | Título: Órdenes de Entrega por Facturar. | Cargo propuesto: Analista de cuentas por cobrar | https://datsoft.truster.cloud/admin-finance/collection/delivery-notes" link="https://datsoft.truster.cloud/admin-finance/collection/delivery-notes" linkTarget="_blank"><mxCell style="rounded=1;arcSize=8;fillColor=#ecfdf5;strokeColor=#0f766e;strokeWidth=1.5;html=0;fontSize=16;fontStyle=0;whiteSpace=wrap;overflow=hidden;spacingTop=10;spacingLeft=13;spacingRight=13;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="650" y="560.0" width="340" height="145.0" as="geometry" /></mxCell></object><object id="abo" label="AF.6.1.3 · Abonos&#10;Consulta los abonos y saldos asociados a facturas." tooltip="Consulta los abonos y saldos asociados a facturas. | Interfaz de consulta observada; ejecución no probada | Cargo propuesto: Analista de cuentas por cobrar | https://datsoft.truster.cloud/admin-finance/collection/partial-payments" link="https://datsoft.truster.cloud/admin-finance/collection/partial-payments" linkTarget="_blank"><mxCell style="rounded=1;arcSize=8;fillColor=#ecfdf5;strokeColor=#0f766e;strokeWidth=1.5;html=0;fontSize=16;fontStyle=0;whiteSpace=wrap;overflow=hidden;spacingTop=10;spacingLeft=13;spacingRight=13;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="1230" y="560.0" width="340" height="145.0" as="geometry" /></mxCell></object><object id="crm" label="CRM.4.1.2 · Clientes&#10;Consulta la información de los clientes del módulo." tooltip="Consulta la información de los clientes del módulo. | No se verificó si esta ficha y Clientes de Comercial comparten el mismo maestro. | Cargo propuesto: Ejecutivo de atención comercial | https://datsoft.truster.cloud/crm/clients-management/clients" link="https://datsoft.truster.cloud/crm/clients-management/clients" linkTarget="_blank"><mxCell style="rounded=1;arcSize=8;fillColor=#ecfdf5;strokeColor=#0f766e;strokeWidth=1.5;html=0;fontSize=16;fontStyle=0;whiteSpace=wrap;overflow=hidden;spacingTop=10;spacingLeft=13;spacingRight=13;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="70" y="560.0" width="340" height="145.0" as="geometry" /></mxCell></object><object id="cuen" label="AF.6.1.5 · Cuentas pendientes&#10;Consulta saldos que siguen pendientes de cobro." tooltip="Consulta saldos que siguen pendientes de cobro. | Interfaz de consulta observada; ejecución no probada | Cargo propuesto: Analista de cuentas por cobrar | https://datsoft.truster.cloud/admin-finance/collection/account-statements" link="https://datsoft.truster.cloud/admin-finance/collection/account-statements" linkTarget="_blank"><mxCell style="rounded=1;arcSize=8;fillColor=#ecfdf5;strokeColor=#0f766e;strokeWidth=1.5;html=0;fontSize=16;fontStyle=0;whiteSpace=wrap;overflow=hidden;spacingTop=10;spacingLeft=13;spacingRight=13;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="650" y="930.0" width="340" height="145.0" as="geometry" /></mxCell></object><object id="prec" label="Ven.5.1.6 · Asignación de Precios&#10;Consulta la asignación de precios y sus referencias de costo." tooltip="Consulta la asignación de precios y sus referencias de costo. | Sincronizar Histórico de Precios y Ajuste masivo visibles; no se ejecutaron. | Cargo propuesto: Coordinador comercial | https://datsoft.truster.cloud/sales/commercial/price-assignment" link="https://datsoft.truster.cloud/sales/commercial/price-assignment" linkTarget="_blank"><mxCell style="rounded=1;arcSize=8;fillColor=#ecfdf5;strokeColor=#0f766e;strokeWidth=1.5;html=0;fontSize=16;fontStyle=0;whiteSpace=wrap;overflow=hidden;spacingTop=10;spacingLeft=13;spacingRight=13;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="70" y="930.0" width="340" height="145.0" as="geometry" /></mxCell></object><object id="com" label="Ven.5.1.9 · Comisiones&#10;Consulta las comisiones de la operación comercial." tooltip="Consulta las comisiones de la operación comercial. | Generar comisión visible; no se ejecutó. | Cargo propuesto: Coordinador comercial | https://datsoft.truster.cloud/sales/commercial/commissions" link="https://datsoft.truster.cloud/sales/commercial/commissions" linkTarget="_blank"><mxCell style="rounded=1;arcSize=8;fillColor=#ecfdf5;strokeColor=#0f766e;strokeWidth=1.5;html=0;fontSize=16;fontStyle=0;whiteSpace=wrap;overflow=hidden;spacingTop=10;spacingLeft=13;spacingRight=13;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="1230" y="930.0" width="340" height="145.0" as="geometry" /></mxCell></object><object id="note" label="" tooltip="Alcance de las conexiones"><mxCell style="rounded=1;arcSize=8;fillColor=#f3f4f6;strokeColor=#6b7280;strokeWidth=1.5;html=0;" vertex="1" parent="1"><mxGeometry x="70" y="1195.0" width="1500" height="125.0" as="geometry" /></mxCell></object><mxCell id="note-title" value="Alcance de las conexiones" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=19;fontStyle=1;fontColor=#14283f;spacing=0;" vertex="1" parent="note" connectable="0"><mxGeometry x="14" y="12.0" width="1472" height="24.0" as="geometry" /></mxCell><mxCell id="note-body" value="R05 también referencia directamente al pedido. No se afirma que toda factura requiera entrega previa. Precios y comisiones se incluyen como consultas observadas; sus disparadores no se comprobaron." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#14283f;spacing=0;" vertex="1" parent="note" connectable="0"><mxGeometry x="14" y="44.0" width="1472" height="75.0" as="geometry" /></mxCell><mxCell id="edge-0" value="R04 · # Pedido" style="edgeStyle=none;html=0;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#0f766e;fontFamily=Arial;fontSize=14;fontColor=#0f766e;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="ped" target="oe"><mxGeometry x="0.0" y="-14" relative="1" as="geometry"><mxPoint 